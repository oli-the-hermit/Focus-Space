{
  "$comment": [
    "Backend parity: one ordered script run against both APIs. scripts/parity/run-web.ts runs it over HTTP against server/index.js; src-tauri/src/backend/parity.rs runs it through dispatch(). Both must pass.",
    "Step: { name, method, path, body?, auth?, repeat?, only?, save?, expect }.",
    "Values: \"$limits.a.b\" is a number from shared/limits.json; \"{{var}}\" is a saved value (a whole-string \"{{var}}\" keeps its type); {\"$repeat\": s, \"times\": n} repeats a string; {\"$add\": [a, b]} adds numbers. They apply everywhere (path, body, auth, repeat, expect).",
    "auth: the bearer token (usually \"{{owner}}\"); no auth sends none. repeat: run the step n times, with {{i}} = 0..n-1. only: \"web\" or \"desktop\".",
    "save: { var: path } after the step. Paths are dot-separated; array indexes may be negative; \"length\" works on arrays and strings.",
    "expect: status; code (then params must equal expect.params, or be absent); body: { path: value }; keys: { path: [exact key set] } (\"\" is the root). A 204 must have an empty body."
  ],
  "scenarios": [
    { "name": "health before setup", "method": "GET", "path": "/api/health",
      "expect": { "status": 200, "body": { "ok": true, "requiresSetup": true }, "keys": { "": ["ok", "requiresSetup"] } } },
    { "name": "unknown route", "method": "GET", "path": "/api/nope",
      "expect": { "status": 404, "code": "NOT_FOUND" } },
    { "name": "unknown method on a known path", "method": "PATCH", "path": "/api/data",
      "expect": { "status": 404, "code": "NOT_FOUND" } },
    { "name": "extra path segment", "method": "GET", "path": "/api/profiles/1/extra",
      "expect": { "status": 404, "code": "NOT_FOUND" } },

    { "name": "setup: username too short", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "ab", "displayName": "Olivia", "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_USERNAME", "params": { "min": "$limits.username.min", "max": "$limits.username.max" } } },
    { "name": "setup: username too long", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": { "$repeat": "a", "times": { "$add": ["$limits.username.max", 1] } }, "displayName": "Olivia", "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_USERNAME", "params": { "min": "$limits.username.min", "max": "$limits.username.max" } } },
    { "name": "setup: username with a space", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "bad name", "displayName": "Olivia", "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_USERNAME", "params": { "min": "$limits.username.min", "max": "$limits.username.max" } } },
    { "name": "setup: username missing", "method": "POST", "path": "/api/auth/setup",
      "body": { "displayName": "Olivia", "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_USERNAME", "params": { "min": "$limits.username.min", "max": "$limits.username.max" } } },
    { "name": "setup: display name blank", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "olivia", "displayName": "   ", "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_DISPLAY_NAME", "params": { "min": "$limits.displayName.min", "max": "$limits.displayName.max" } } },
    { "name": "setup: display name too long", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "olivia", "displayName": { "$repeat": "x", "times": { "$add": ["$limits.displayName.max", 1] } }, "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_DISPLAY_NAME", "params": { "min": "$limits.displayName.min", "max": "$limits.displayName.max" } } },
    { "name": "setup: password too short", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "olivia", "displayName": "Olivia", "password": { "$repeat": "p", "times": { "$add": ["$limits.password.min", -1] } } },
      "expect": { "status": 400, "code": "INVALID_PASSWORD", "params": { "min": "$limits.password.min", "max": "$limits.password.max" } } },
    { "name": "setup: password not a string", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "olivia", "displayName": "Olivia", "password": 12345678 },
      "expect": { "status": 400, "code": "INVALID_PASSWORD", "params": { "min": "$limits.password.min", "max": "$limits.password.max" } } },
    { "name": "setup: success (display name trimmed)", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "olivia", "displayName": " Olivia ", "password": "password123" },
      "save": { "owner": "token", "ownerId": "profile.id" },
      "expect": { "status": 201,
        "body": { "profile.username": "olivia", "profile.displayName": "Olivia", "profile.role": "owner", "profile.avatar": "", "data.iv": "", "data.cipher": "", "data.salt.length": 32 },
        "keys": { "": ["token", "profile", "data"], "profile": ["id", "username", "displayName", "avatar", "role", "createdAt", "updatedAt"], "data": ["salt", "iv", "cipher"] } } },
    { "name": "setup: only once", "method": "POST", "path": "/api/auth/setup",
      "body": { "username": "other", "displayName": "Other", "password": "password123" },
      "expect": { "status": 409, "code": "ALREADY_SET_UP" } },
    { "name": "health after setup", "method": "GET", "path": "/api/health",
      "expect": { "status": 200, "body": { "requiresSetup": false } } },

    { "name": "login: password missing", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "olivia" },
      "expect": { "status": 400, "code": "CREDENTIALS_REQUIRED" } },
    { "name": "login: username not a string", "method": "POST", "path": "/api/auth/login",
      "body": { "username": 42, "password": "password123" },
      "expect": { "status": 400, "code": "CREDENTIALS_REQUIRED" } },
    { "name": "login: no body", "method": "POST", "path": "/api/auth/login",
      "expect": { "status": 400, "code": "CREDENTIALS_REQUIRED" } },
    { "name": "login: wrong password", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "olivia", "password": "wrong-pass" },
      "expect": { "status": 401, "code": "INVALID_CREDENTIALS" } },
    { "name": "login: success, username case-insensitive", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "OLIVIA", "password": "password123" },
      "save": { "ownerLogin": "token" },
      "expect": { "status": 200, "body": { "profile.username": "olivia", "data.salt.length": 32 },
        "keys": { "": ["token", "profile", "data"], "profile": ["id", "username", "displayName", "avatar", "role", "createdAt", "updatedAt"], "data": ["salt", "iv", "cipher"] } } },
    { "name": "login: failures up to the lockout", "method": "POST", "path": "/api/auth/login",
      "repeat": "$limits.login.maxFailures",
      "body": { "username": "ghost", "password": "wrong-pass" },
      "expect": { "status": 401, "code": "INVALID_CREDENTIALS" } },
    { "name": "login: locked out", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "Ghost", "password": "wrong-pass" },
      "expect": { "status": 429, "code": "TOO_MANY_ATTEMPTS", "params": { "seconds": "$limits.login.lockoutSeconds" } } },

    { "name": "me: no token", "method": "GET", "path": "/api/auth/me",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },
    { "name": "me: unknown token", "method": "GET", "path": "/api/auth/me", "auth": "not-a-real-token",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },
    { "name": "me: owner", "method": "GET", "path": "/api/auth/me", "auth": "{{owner}}",
      "expect": { "status": 200, "body": { "profile.id": "{{ownerId}}", "profile.username": "olivia", "profile.role": "owner" },
        "keys": { "": ["profile"], "profile": ["id", "username", "displayName", "avatar", "role"] } } },

    { "name": "data: empty at first", "method": "GET", "path": "/api/data", "auth": "{{owner}}",
      "expect": { "status": 200, "body": { "iv": "", "cipher": "", "salt.length": 32 }, "keys": { "": ["salt", "iv", "cipher"] } } },
    { "name": "data: bad iv", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "short", "cipher": "c2VjcmV0LWJsb2I=" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "data: cipher missing", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "data: cipher empty", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": "" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "data: cipher not base64", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": "not base64!" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "data: iv not base64", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA!!","cipher": "c2VjcmV0LWJsb2I=" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "data: cipher base64url", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": "c2VjcmV0-WJsb2I=" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "data: cipher with non-zero trailing bits", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": "c2VjcmV0LWJsb2J=" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "data: unpadded base64 is accepted", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": "c2VjcmV0LWJsb2I" },
      "expect": { "status": 204 } },
    { "name": "data: save", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": "c2VjcmV0LWJsb2I=" },
      "expect": { "status": 204 } },
    { "name": "data: read back", "method": "GET", "path": "/api/data", "auth": "{{owner}}",
      "expect": { "status": 200, "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": "c2VjcmV0LWJsb2I=" } } },
    { "name": "data: no token", "method": "GET", "path": "/api/data",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },
    { "name": "data: body over the HTTP limit (web only)", "only": "web", "method": "PUT", "path": "/api/data", "auth": "{{owner}}",
      "body": { "iv": "AAAAAAAAAAAAAAAA", "cipher": { "$repeat": "A", "times": 2200000 } },
      "expect": { "status": 413, "code": "PAYLOAD_TOO_LARGE" } },

    { "name": "profile: nothing to change", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": {},
      "expect": { "status": 400, "code": "NO_CHANGES" } },
    { "name": "profile: avatar not a string", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "avatar": 123 },
      "expect": { "status": 400, "code": "AVATAR_TOO_LARGE" } },
    { "name": "profile: avatar too large", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "avatar": { "$repeat": "a", "times": { "$add": ["$limits.avatar.maxChars", 1] } } },
      "expect": { "status": 400, "code": "AVATAR_TOO_LARGE" } },
    { "name": "profile: display name blank", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "displayName": "" },
      "expect": { "status": 400, "code": "INVALID_DISPLAY_NAME", "params": { "min": "$limits.displayName.min", "max": "$limits.displayName.max" } } },
    { "name": "profile: username invalid", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "username": "no spaces" },
      "expect": { "status": 400, "code": "INVALID_USERNAME", "params": { "min": "$limits.username.min", "max": "$limits.username.max" } } },
    { "name": "profile: update name and avatar", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "displayName": " Liv ", "avatar": "" },
      "expect": { "status": 200, "body": { "profile.displayName": "Liv", "profile.avatar": "" },
        "keys": { "": ["profile"], "profile": ["id", "username", "displayName", "avatar", "role", "createdAt", "updatedAt"] } } },

    { "name": "profiles: create sam", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "body": { "username": "sam", "displayName": "Sam", "password": "password123" },
      "save": { "samId": "profile.id" },
      "expect": { "status": 201, "body": { "profile.username": "sam", "profile.role": "user" },
        "keys": { "": ["profile"], "profile": ["id", "username", "displayName", "avatar", "role", "createdAt", "updatedAt"] } } },
    { "name": "profiles: username taken (any case)", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "body": { "username": "SAM", "displayName": "Sam", "password": "password123" },
      "expect": { "status": 409, "code": "USERNAME_TAKEN" } },
    { "name": "profiles: create with bad username", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "body": { "username": "x", "displayName": "X", "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_USERNAME", "params": { "min": "$limits.username.min", "max": "$limits.username.max" } } },
    { "name": "profiles: create with bad display name", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "body": { "username": "xavier", "displayName": " ", "password": "password123" },
      "expect": { "status": 400, "code": "INVALID_DISPLAY_NAME", "params": { "min": "$limits.displayName.min", "max": "$limits.displayName.max" } } },
    { "name": "profiles: create with bad password", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "body": { "username": "xavier", "displayName": "Xavier", "password": "short" },
      "expect": { "status": 400, "code": "INVALID_PASSWORD", "params": { "min": "$limits.password.min", "max": "$limits.password.max" } } },
    { "name": "profile: username taken by sam", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "username": "Sam" },
      "expect": { "status": 409, "code": "USERNAME_TAKEN" } },
    { "name": "profile: own username, new case", "method": "PUT", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "username": "Olivia" },
      "expect": { "status": 200, "body": { "profile.username": "Olivia" } } },

    { "name": "login: sam", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "sam", "password": "password123" },
      "save": { "user": "token", "userOld": "token" },
      "expect": { "status": 200, "body": { "profile.role": "user" } } },
    { "name": "owner route as user: list", "method": "GET", "path": "/api/profiles", "auth": "{{user}}",
      "expect": { "status": 403, "code": "OWNER_ONLY" } },
    { "name": "owner route as user: create", "method": "POST", "path": "/api/profiles", "auth": "{{user}}",
      "body": { "username": "nope", "displayName": "Nope", "password": "password123" },
      "expect": { "status": 403, "code": "OWNER_ONLY" } },
    { "name": "owner route as user: rename", "method": "PUT", "path": "/api/profiles/{{ownerId}}", "auth": "{{user}}",
      "body": { "displayName": "Hacked" },
      "expect": { "status": 403, "code": "OWNER_ONLY" } },
    { "name": "owner route as user: delete", "method": "DELETE", "path": "/api/profiles/{{ownerId}}", "auth": "{{user}}",
      "expect": { "status": 403, "code": "OWNER_ONLY" } },
    { "name": "owner route as user: reset", "method": "POST", "path": "/api/reset-profiles", "auth": "{{user}}",
      "body": { "password": "password123" },
      "expect": { "status": 403, "code": "OWNER_ONLY" } },
    { "name": "owner route without a token", "method": "GET", "path": "/api/profiles",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },

    { "name": "profiles: rename sam", "method": "PUT", "path": "/api/profiles/{{samId}}", "auth": "{{owner}}",
      "body": { "displayName": " Samuel " },
      "expect": { "status": 200, "body": { "profile.id": "{{samId}}", "profile.displayName": "Samuel" } } },
    { "name": "profiles: rename with bad display name", "method": "PUT", "path": "/api/profiles/999", "auth": "{{owner}}",
      "body": { "displayName": "" },
      "expect": { "status": 400, "code": "INVALID_DISPLAY_NAME", "params": { "min": "$limits.displayName.min", "max": "$limits.displayName.max" } } },
    { "name": "profiles: rename unknown id", "method": "PUT", "path": "/api/profiles/999", "auth": "{{owner}}",
      "body": { "displayName": "X" },
      "expect": { "status": 404, "code": "PROFILE_NOT_FOUND" } },
    { "name": "profiles: rename non-numeric id", "method": "PUT", "path": "/api/profiles/abc", "auth": "{{owner}}",
      "body": { "displayName": "X" },
      "expect": { "status": 404, "code": "PROFILE_NOT_FOUND" } },
    { "name": "profiles: delete unknown id", "method": "DELETE", "path": "/api/profiles/999", "auth": "{{owner}}",
      "expect": { "status": 404, "code": "PROFILE_NOT_FOUND" } },
    { "name": "profiles: owner can't delete itself by id", "method": "DELETE", "path": "/api/profiles/{{ownerId}}", "auth": "{{owner}}",
      "expect": { "status": 400, "code": "OWNER_UNDELETABLE" } },
    { "name": "profile delete: password required first", "method": "DELETE", "path": "/api/profile", "auth": "{{owner}}",
      "expect": { "status": 400, "code": "PASSWORD_REQUIRED" } },
    { "name": "profile delete: owner can't delete itself", "method": "DELETE", "path": "/api/profile", "auth": "{{owner}}",
      "body": { "password": "password123" },
      "expect": { "status": 403, "code": "OWNER_UNDELETABLE" } },

    { "name": "self-delete: create temp", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "body": { "username": "temp", "displayName": "Temp", "password": "password123" },
      "expect": { "status": 201 } },
    { "name": "self-delete: login temp", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "temp", "password": "password123" },
      "save": { "temp": "token" },
      "expect": { "status": 200 } },
    { "name": "self-delete: wrong password", "method": "DELETE", "path": "/api/profile", "auth": "{{temp}}",
      "body": { "password": "wrong-pass" },
      "expect": { "status": 401, "code": "WRONG_PASSWORD" } },
    { "name": "self-delete: success", "method": "DELETE", "path": "/api/profile", "auth": "{{temp}}",
      "body": { "password": "password123" },
      "expect": { "status": 204 } },
    { "name": "self-delete: session is gone", "method": "GET", "path": "/api/auth/me", "auth": "{{temp}}",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },

    { "name": "password: current missing", "method": "PUT", "path": "/api/profile/password", "auth": "{{user}}",
      "body": { "newPassword": "new-password-456" },
      "expect": { "status": 400, "code": "CURRENT_PASSWORD_REQUIRED" } },
    { "name": "password: current wrong", "method": "PUT", "path": "/api/profile/password", "auth": "{{user}}",
      "body": { "currentPassword": "nope", "newPassword": "new-password-456" },
      "expect": { "status": 401, "code": "WRONG_CURRENT_PASSWORD" } },
    { "name": "password: new too short", "method": "PUT", "path": "/api/profile/password", "auth": "{{user}}",
      "body": { "currentPassword": "password123", "newPassword": "short" },
      "expect": { "status": 400, "code": "INVALID_NEW_PASSWORD", "params": { "min": "$limits.password.min", "max": "$limits.password.max" } } },
    { "name": "password: bad salt", "method": "PUT", "path": "/api/profile/password", "auth": "{{user}}",
      "body": { "currentPassword": "password123", "newPassword": "new-password-456", "salt": "zz", "iv": "AAAAAAAAAAAAAAAA", "cipher": "c2VjcmV0LWJsb2I=" },
      "expect": { "status": 400, "code": "SAVE_FAILED" } },
    { "name": "password: change", "method": "PUT", "path": "/api/profile/password", "auth": "{{user}}",
      "body": { "currentPassword": "password123", "newPassword": "new-password-456", "salt": "00112233445566778899aabbccddeeff", "iv": "AAAAAAAAAAAAAAAA", "cipher": "c2VjcmV0LWJsb2I=" },
      "save": { "user": "token" },
      "expect": { "status": 200, "body": { "profile.username": "sam" },
        "keys": { "": ["token", "profile"], "profile": ["id", "username", "displayName", "avatar", "role", "createdAt", "updatedAt"] } } },
    { "name": "password: old session ended", "method": "GET", "path": "/api/auth/me", "auth": "{{userOld}}",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },
    { "name": "password: new session works", "method": "GET", "path": "/api/auth/me", "auth": "{{user}}",
      "expect": { "status": 200 } },
    { "name": "password: old password rejected", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "sam", "password": "password123" },
      "expect": { "status": 401, "code": "INVALID_CREDENTIALS" } },
    { "name": "password: login with the new one", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "sam", "password": "new-password-456" },
      "expect": { "status": 200, "body": { "data.salt": "00112233445566778899aabbccddeeff", "data.iv": "AAAAAAAAAAAAAAAA", "data.cipher": "c2VjcmV0LWJsb2I=" } } },

    { "name": "limit: fill up to the maximum", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "repeat": { "$add": ["$limits.maxProfiles", -2] },
      "body": { "username": "user{{i}}", "displayName": "User {{i}}", "password": "password123" },
      "expect": { "status": 201 } },
    { "name": "limit: one more is refused", "method": "POST", "path": "/api/profiles", "auth": "{{owner}}",
      "body": { "username": "extra", "displayName": "Extra", "password": "password123" },
      "expect": { "status": 409, "code": "PROFILE_LIMIT", "params": { "max": "$limits.maxProfiles" } } },
    { "name": "limit: list, users first then the owner", "method": "GET", "path": "/api/profiles", "auth": "{{owner}}",
      "expect": { "status": 200, "body": { "profiles.length": "$limits.maxProfiles", "profiles.0.username": "sam", "profiles.-1.role": "owner" },
        "keys": { "": ["profiles"], "profiles.0": ["id", "username", "displayName", "avatar", "role", "createdAt", "updatedAt"] } } },

    { "name": "reset: password required", "method": "POST", "path": "/api/reset-profiles", "auth": "{{owner}}",
      "expect": { "status": 400, "code": "PASSWORD_REQUIRED" } },
    { "name": "reset: wrong password", "method": "POST", "path": "/api/reset-profiles", "auth": "{{owner}}",
      "body": { "password": "wrong-pass" },
      "expect": { "status": 401, "code": "WRONG_PASSWORD" } },
    { "name": "reset: deletes every user profile", "method": "POST", "path": "/api/reset-profiles", "auth": "{{owner}}",
      "body": { "password": "password123" },
      "expect": { "status": 200, "body": { "deleted": { "$add": ["$limits.maxProfiles", -1] } }, "keys": { "": ["deleted"] } } },
    { "name": "reset: their sessions are gone", "method": "GET", "path": "/api/auth/me", "auth": "{{user}}",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },
    { "name": "reset: only the owner is left", "method": "GET", "path": "/api/profiles", "auth": "{{owner}}",
      "expect": { "status": 200, "body": { "profiles.length": 1, "profiles.0.role": "owner" } } },

    { "name": "logout", "method": "POST", "path": "/api/auth/logout", "auth": "{{owner}}",
      "expect": { "status": 204 } },
    { "name": "logout: session ended", "method": "GET", "path": "/api/auth/me", "auth": "{{owner}}",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } },
    { "name": "logout: other sessions stay", "method": "GET", "path": "/api/auth/me", "auth": "{{ownerLogin}}",
      "expect": { "status": 200 } },
    { "name": "logout: without a token", "method": "POST", "path": "/api/auth/logout",
      "expect": { "status": 401, "code": "SESSION_EXPIRED" } }
  ]
}
