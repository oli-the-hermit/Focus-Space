{
  "name": "focus-space-time-tracker",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js --static",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:web": "vite",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "visual:capture": "node scripts/visual/capture.ts",
    "visual:baseline": "node scripts/visual/capture.ts --out documentation/visual/baseline",
    "visual:diff": "node scripts/visual/diff.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.5",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
