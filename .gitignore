# -----------------------------------------------------------------------------
# Standard General .gitignore for Web & JavaScript Development
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing & Coverage
coverage/
.nyc_output/
cypress/screenshots/
cypress/videos/
test-results/
.playwright/

# Production & Build Outputs
build/
dist/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
.tern-port
.cache/
.parcel-cache/
.turbo/
.svelte-kit/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local database (user profiles & encrypted data)
server/data/

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Editor & IDE Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary Files & Diagnostics
tmp/
temp/
.tmp/
*.tmp
*.bak
*.orig
