# -----------------------------------------------------------------------------
# FocusSpace Time Tracker - Git Ignore Rules
# -----------------------------------------------------------------------------

# Internal Team Documentation (Knowledge Base)
documentation/

# Dependencies
node_modules/
.pnp
.pnp.js

# Local database (SQLite user profiles & encrypted data)
server/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Production & Web Build Outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
.tsbuildinfo
*.tsbuildinfo
.eslintcache
.stylelintcache

# Desktop App Build & Packaging Artifacts (Electron / Tauri)
dist-electron/
# Only a top-level build folder: scripts/release/ (the release workflow's scripts) is tracked.
/release/
src-tauri/target/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm

# Testing & Coverage
coverage/
.nyc_output/
cypress/screenshots/
cypress/videos/
test-results/
.playwright/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local Tooling & Binaries
npm/

# Local-only overrides (Vite *.local env files, per-user editor and assistant tooling)
*.local
.claude/

# Editor & IDE Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary Files & Diagnostics
tmp/
temp/
.tmp/
*.tmp
*.bak
*.orig

# Release build config, generated from shared/release.json (scripts/release/config.ts)
src-tauri/tauri.release.conf.json
